# Copy this file to .env and adjust if needed:
#   cp .env.example .env
# .env is ignored by git. Never commit real secrets.

# PostgreSQL connection. Matches docker-compose.yml.
DATABASE_URL="postgresql://campustrace:campustrace@localhost:5432/campustrace?schema=public"

# The address the app is served from.
NEXTAUTH_URL="http://localhost:3000"

# Signs session cookies. Generate your own with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-the-output-of-openssl-rand-base64-32"

# Where uploaded photos and evidence are stored.
#   local        a folder on this machine (must be outside /public)
#   vercel-blob  a private Vercel Blob store (see docs/deployment.md)
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"

# Email domains allowed to register, comma-separated. Leave empty to allow any.
ALLOWED_EMAIL_DOMAINS="stu.ucc.edu.gh,ucc.edu.gh"
